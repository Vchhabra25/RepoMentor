# App
APP_NAME=RepoMentor AI
ENVIRONMENT=development
DEBUG=true

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Firebase Admin SDK
# Path to a service-account JSON key (Firebase Console > Project Settings > Service Accounts)
FIREBASE_CREDENTIALS_PATH=
FIREBASE_PROJECT_ID=

# Uploads
MAX_UPLOAD_SIZE_MB=100

# Repository ingestion
# Where ingested repositories are extracted/cloned to on disk
REPOSITORY_STORAGE_DIR=data/repositories
# Reject repositories larger than this after extraction/clone
MAX_REPOSITORY_SIZE_MB=150

# AI layer
# Which provider backs the AI Orchestrator (Project Overview, Architecture,
# Interview Coach, etc.) — without a valid key for whichever provider is
# selected, /api/repository/{id}/ai/* endpoints return 503.
AI_PROVIDER=groq
AI_MAX_TOKENS=4096
AI_REQUEST_TIMEOUT_SECONDS=60

# Groq (used when AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anthropic (used when AI_PROVIDER=claude — kept for reference/rollback)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# Rate limiting (simple in-memory sliding window, per client IP)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_AI_REQUESTS_PER_MINUTE=10
